PORT=8787

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Stripe (test mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PLATFORM_FEE_BPS=500

# Claude
ANTHROPIC_API_KEY=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/api/v1/integrations/google/callback
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=

# 32+ random chars, used only to generate handoff confirmation codes
HANDOFF_SECRET=

# APNs
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=

# Web push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Misc
GROUPME_BOT_TOKEN=
RESEND_API_KEY=
WEB_ORIGIN=http://localhost:3000
APP_URL_SCHEME=

# Library room booking: manual | demo
ROOM_BOOKER=manual
ROOM_BOOKING_URL=https://www.lib.ua.edu/
# Live free Gorgas study rooms from ua.libcal.com (read-only, never books): on | off
LIBCAL=on

# Marketplace: demo (orders are marked paid without a card) | stripe (not built yet)
PAYMENTS=demo
# Instagram (Instagram API with Instagram Login, our business/creator account)
# off | graph (poll posts that tag us, list them, reply on the post)
#     | stories (poll the seller account's own stories, list them, DM the seller; see docs/INSTAGRAM_SETUP.md)
INSTAGRAM=off
INSTAGRAM_ACCESS_TOKEN=
# Optional; looked up from the token if empty
INSTAGRAM_USER_ID=
INSTAGRAM_GRAPH_URL=https://graph.instagram.com/v23.0
INSTAGRAM_POLL_SECONDS=15
# on: reply on the post (graph) or DM the seller (stories, only while the seller's 24 h window is open)
INSTAGRAM_AUTO_REPLY=on
# Stories mode only: the seller account's own token, and optionally its username (looked up if empty)
INSTAGRAM_SELLER_TOKEN=
INSTAGRAM_SELLER_USERNAME=
# Optional; the seller's id as our account sees it, looked up from our DM conversations if empty
INSTAGRAM_SELLER_IGSID=
INSTAGRAM_SCHOOL_ID=00000000-0000-4000-a000-000000000001

# Textbook identification: auto (Claude vision if ANTHROPIC_API_KEY is set) | claude | caption
IDENTIFIER=auto
CLAUDE_VISION_MODEL=claude-sonnet-5-5

# Shown in the claim DM to Instagram sellers; claim links point at WEB_ORIGIN
APP_NAME=Campus Marketplace
