# Same Supabase project as backend/.env. The service key never leaves this laptop: keep it out of git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemma 4 through Ollama (`ollama pull gemma4:e4b`).
GEMMA_MODEL=gemma4:e4b
OLLAMA_HOST_URL=http://localhost:11434

# JEV-9B from the Hugging Face cache. 4bit (~6 GB) fits beside Gemma on a 16 GB GPU; 8bit ~10 GB; bf16 ~18 GB.
JEV_REPO=autotrust/JEV-9B
JEV_QUANT=4bit

# WORKER_ID=laptop-kori
# POLL_SECONDS=0.4
