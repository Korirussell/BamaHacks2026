# Leave unset (or "true") for the scripted demo. Set to "false" to use the real API.
NEXT_PUBLIC_USE_MOCKS=
# API origin, no trailing slash and no /api/v1 (e.g. the backend deploy URL)
NEXT_PUBLIC_API_BASE=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Publishable key only (pk_test_...). Never a secret key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
